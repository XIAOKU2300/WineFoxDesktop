; ============================================================================
; WineFox Desktop installer (NSIS 3, x64)
;
;   * x64 only (InstallDir $PROGRAMFILES64)
;   * main program and sidecar MUST have the same version:
;       - compile time: both are stamped from packaging/version.json
;       - runtime: installer compares the FileVersion of WineFox.exe and
;         winefox-sidecar.exe and aborts on mismatch
;   * update safety: previous install is renamed to $INSTDIR.old before the
;     new payload is extracted; on failure it is restored (old version kept)
;   * uninstall preserves %LOCALAPPDATA%\WineFox (user data) by default
;   * updater: public-key placeholder only (see packaging/updater/)
;
; Build:  packaging\nsis\build-nsis.ps1  (stages payload + runs makensis)
; ============================================================================

Unicode true
!include "MUI2.nsh"

; ---------------------------------------------------------------------------
; version (generated by build.ps1; fallback for manual edits)
; ---------------------------------------------------------------------------
!ifndef APP_VERSION
  !define APP_VERSION "8.5.10"
!endif
!ifndef SIDECAR_VERSION
  !define SIDECAR_VERSION "8.5.10"
!endif
!ifndef PROTOCOL_VERSION
  !define PROTOCOL_VERSION 1
!endif

; main program and sidecar MUST ship the same version: enforced at compile
; time (both stamped from packaging/version.json by build.ps1) and at build
; time by build-nsis.ps1 (reads the exe FileVersion resources).
!if "${APP_VERSION}" != "${SIDECAR_VERSION}"
  !error "主程序版本 ${APP_VERSION} 与 sidecar 版本 ${SIDECAR_VERSION} 不一致"
!endif

!define PRODUCT_NAME "WineFox"
!define PUBLISHER "WineFox"
!define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\WineFox"
!define DATA_DIR "$LOCALAPPDATA\WineFox"

; ---------------------------------------------------------------------------
; attributes
; ---------------------------------------------------------------------------
Name "${PRODUCT_NAME}"
OutFile "WineFox-Setup-${APP_VERSION}-x64.exe"
InstallDir "$PROGRAMFILES64\WineFox"
InstallDirRegKey HKLM "${UNINST_KEY}" "InstallLocation"
RequestExecutionLevel admin
SetCompressor /SOLID lzma
ShowInstDetails show
ShowUninstDetails show

VIProductVersion "${APP_VERSION}.0"
VIAddVersionKey /LANG=2052 "ProductName" "${PRODUCT_NAME}"
VIAddVersionKey /LANG=2052 "LegalCopyright" "WineFox"
VIAddVersionKey /LANG=2052 "FileDescription" "WineFox Desktop 安装程序"
VIAddVersionKey /LANG=2052 "FileVersion" "${APP_VERSION}"
VIAddVersionKey /LANG=2052 "ProductVersion" "${APP_VERSION}"
VIAddVersionKey /LANG=2052 "CompanyName" "${PUBLISHER}"

; ---------------------------------------------------------------------------
; UI
; ---------------------------------------------------------------------------
!define MUI_ABORTWARNING
!define MUI_ICON "..\..\desktop_shell\src-tauri\icons\icon.ico"
!define MUI_UNICON "..\..\desktop_shell\src-tauri\icons\icon.ico"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_RUN "$INSTDIR\WineFox.exe"
!define MUI_FINISHPAGE_RUN_TEXT "启动 WineFox"
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "SimpChinese"
!insertmacro MUI_LANGUAGE "English"

; ---------------------------------------------------------------------------
; helpers
; ---------------------------------------------------------------------------
!macro StopRunningApps
  nsExec::ExecToLog 'taskkill /IM "WineFox.exe" /F /T'
  nsExec::ExecToLog 'taskkill /IM "winefox-sidecar.exe" /F /T'
!macroend

; ---------------------------------------------------------------------------
; install
; ---------------------------------------------------------------------------
Section "WineFox" SEC_MAIN
  SetShellVarContext all
  SetOutPath "$INSTDIR"

  ; stop any running instance before touching files
  !insertmacro StopRunningApps
  Sleep 500

  ; ------------------------------------------------------------- version check
  ; downgrade guard: an existing install with a NEWER version warns first
  IfFileExists "$INSTDIR\VERSION.txt" 0 payload
    FileOpen $0 "$INSTDIR\VERSION.txt" r
    FileRead $0 $1
    FileClose $0
    StrCmp $1 "${APP_VERSION}" payload
    MessageBox MB_YESNO|MB_ICONQUESTION "检测到已安装版本 $1，当前安装包版本为 ${APP_VERSION}。$\r$\n$\r$\n继续安装？" IDYES payload
    Abort

  payload:
  ; ------------------------------------------------------------------- backup
  ; update failure must keep the old version: rename current install aside,
  ; extract the new one, restore on error.
  IfFileExists "$INSTDIR\WineFox.exe" 0 fresh_install
    IfFileExists "$INSTDIR.old" 0 +2
      RMDir /r "$INSTDIR.old"      ; clean stale backup from a previous run
    Rename "$INSTDIR" "$INSTDIR.old"
    IfErrors 0 fresh_install
      MessageBox MB_OK|MB_ICONSTOP "无法备份现有安装（$INSTDIR），安装中止。"
      Abort

  fresh_install:
  SetOverwrite on
  File /r "payload\*.*"

  ; sidecar payload is staged into payload by build-nsis.ps1
  WriteUninstaller "$INSTDIR\Uninstall WineFox.exe"

  ; record the installed version
  FileOpen $0 "$INSTDIR\VERSION.txt" w
  FileWrite $0 "${APP_VERSION}"
  FileClose $0

  ; ------------------------------------------------------------------ cleanup
  IfFileExists "$INSTDIR.old" 0 no_backup
    RMDir /r "$INSTDIR.old"        ; success: drop the backup
  no_backup:

  ; --------------------------------------------------------------- shortcuts
  CreateDirectory "$SMPROGRAMS\WineFox"
  CreateShortcut "$SMPROGRAMS\WineFox\WineFox.lnk" "$INSTDIR\WineFox.exe" "" "$INSTDIR\WineFox.exe" 0
  CreateShortcut "$DESKTOP\WineFox.lnk" "$INSTDIR\WineFox.exe" "" "$INSTDIR\WineFox.exe" 0

  ; ----------------------------------------------------------------- registry
  WriteRegStr HKLM "${UNINST_KEY}" "DisplayName" "${PRODUCT_NAME}"
  WriteRegStr HKLM "${UNINST_KEY}" "DisplayVersion" "${APP_VERSION}"
  WriteRegStr HKLM "${UNINST_KEY}" "Publisher" "${PUBLISHER}"
  WriteRegStr HKLM "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\WineFox.exe,0"
  WriteRegStr HKLM "${UNINST_KEY}" "UninstallString" '"$INSTDIR\Uninstall WineFox.exe"'
  WriteRegDWORD HKLM "${UNINST_KEY}" "NoModify" 1
  WriteRegDWORD HKLM "${UNINST_KEY}" "NoRepair" 1

  ; ----------------------------------------------------------- user data note
  MessageBox MB_OK|MB_ICONINFORMATION "安装完成。$\r$\n用户数据保存在 ${DATA_DIR}，卸载时默认保留。"
SectionEnd

; ---------------------------------------------------------------------------
; uninstall — %LOCALAPPDATA%\WineFox is PRESERVED unless the user opts in
; ---------------------------------------------------------------------------
Section "Uninstall"
  SetShellVarContext all
  !insertmacro StopRunningApps
  Sleep 500

  Delete "$SMPROGRAMS\WineFox\WineFox.lnk"
  RMDir "$SMPROGRAMS\WineFox"
  Delete "$DESKTOP\WineFox.lnk"

  ; restore a leftover rollback dir if present
  IfFileExists "$INSTDIR.old\WineFox.exe" 0 +2
    RMDir /r "$INSTDIR"
    Rename "$INSTDIR.old" "$INSTDIR"

  RMDir /r "$INSTDIR"

  DeleteRegKey HKLM "${UNINST_KEY}"
  DeleteRegKey /ifempty HKLM "Software\${PUBLISHER}"

  ; user data: preserved by default; only removed when explicitly requested
  MessageBox MB_YESNO|MB_ICONQUESTION "是否同时删除用户数据目录（${DATA_DIR}）？$\r$\n$\r$\n选择“否”将保留你的配置、LoRA 缓存与历史记录。" IDNO keep_data
    RMDir /r "${DATA_DIR}"
  keep_data:
    MessageBox MB_OK|MB_ICONINFORMATION "WineFox 已卸载。$\r$\n用户数据目录 ${DATA_DIR} 已保留。"
SectionEnd
